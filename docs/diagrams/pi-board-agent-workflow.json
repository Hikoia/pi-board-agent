{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "pi-board-agent 工作流程",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "backend": { "label": "插件／模型執行" },
        "cloud": { "label": "GitHub 看板" },
        "security": { "label": "審查／人工關卡" },
        "database": { "label": "Git 整合／持久狀態" }
      }
    }
  },
  "lanes": [
    { "id": "board_control", "label": "啟動與調度" },
    { "id": "model_execution", "label": "建置與審查" },
    { "id": "human_authority", "label": "人工決策／驗收" },
    { "id": "git_finalization", "label": "整合與收尾" }
  ],
  "mainPath": [
    "owner_poll", "ready_task", "persistent_builder", "pinned_review",
    "done_open", "human_close", "native_merge", "safe_cleanup", "closed_backlog"
